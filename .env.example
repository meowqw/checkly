# Database
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=finance_manager
MYSQL_USER=finance
MYSQL_PASSWORD=finance123

DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance_manager
DB_USER=finance
DB_PASSWORD=finance123

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# External services
PROVERKACHEKA_TOKEN=your_proverkacheka_token

# Нормализация товаров из чека: auto | groq | grok | gpt
# Groq (console.groq.com) — ключ gsk_...
# xAI Grok (console.x.ai) — ключ xai-...
PRODUCT_NORMALIZER=auto
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROK_API_KEY=your_xai_grok_api_key
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# App
APP_DEBUG=false
# CORS для мобильного клиента (Capacitor), пример: http://192.168.1.10:5173
CORS_ORIGINS=