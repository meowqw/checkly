# Сборка для телефона / эмулятора Android (скопируйте в .env.production.local перед npm run build)
#
# Телефон в той же Wi‑Fi, backend на Mac/PC:
# VITE_API_URL=http://192.168.1.10:8000
#
# Эмулятор Android Studio (backend на хосте):
# VITE_API_URL=http://10.0.2.2:8000
#
# Продакшен (VPS с HTTPS):
# VITE_API_URL=https://api.example.com

VITE_API_URL=http://192.168.1.10:8000
